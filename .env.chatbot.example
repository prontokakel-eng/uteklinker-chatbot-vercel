# Server-only configuration. Do not commit actual credentials.
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_MODEL=gpt-4o-mini
# Comma-separated Drive Excel IDs or native Sheets with FAQ_SE/DA/DE/EN.
# Candidate files must be confirmed before deployment.
FAQ_DRIVE_FILE_IDS=
FAQ_CACHE_TTL_SECONDS=300
GCP_CLIENT_EMAIL=
GCP_PRIVATE_KEY=
# Verified Google profile. currentOpeningHours includes special opening hours.
GOOGLE_PLACE_ID=
GOOGLE_PLACES_API_KEY=
# Explicit activation only after server-key, quota, attribution and cost review.
# The PENDING key is never used. Do not copy the website-restricted key here.
GOOGLE_PLACES_ENABLED=false
# Anonymous public-site source pilot. Only active in VERCEL_ENV=preview.
WEBSITE_KNOWLEDGE_ENABLED=false
CONTACT_EMAIL=
CONTACT_EMAIL_VERIFIED=false
CONTACT_PHONE=
CONTACT_PHONE_VERIFIED=false
CONTACT_RESPONSE_NOTE=
# Actual staffed provider, plus provider presence JSON {"available":true}.
LIVE_CHAT_URL=
LIVE_CHAT_PRESENCE_URL=
LIVE_CHAT_PRESENCE_TOKEN=
